RewriteEngine On

# 1) Don't touch real files/folders
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 2) Exclude these folders from rewrites
RewriteRule ^(phpscripts|assets|includes|database|node_modules|components)/ - [L]

# 3) If someone visits /pages/... redirect to clean URL (remove /pages)
RewriteRule ^pages/(librarian|student)/(.+?)/?$ $1/$2 [R=301,L,NC]
RewriteRule ^pages/(.+?)/?$ $1 [R=301,L,NC]

# 4) Remove .php in URL (redirect /page.php -> /page)
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
RewriteRule ^ %1 [R=301,L]

# 5) Role routes:
#    /librarian/dashboard -> /pages/librarian/dashboard.php
RewriteCond pages/librarian/$1.php -f
RewriteRule ^librarian/(.+?)/?$ pages/librarian/$1.php [L,NC]

#    /student/dashboard -> /pages/student/dashboard.php
RewriteCond pages/student/$1.php -f
RewriteRule ^student/(.+?)/?$ pages/student/$1.php [L,NC]

# 6) Root-level pages: /login -> login.php, /createAccount -> createAccount.php
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L]