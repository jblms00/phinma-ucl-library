# .htaccess (project root)
RewriteEngine On

# Don't touch real files/folders
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Exclude these folders from rewrites
RewriteRule ^(phpscripts|assets|includes|database|node_modules|components)/ - [L]

# Remove .php in URL (front pages only)
RewriteCond %{THE_REQUEST} \s/+(.*)\.php[\s?] [NC]
RewriteRule ^ %1 [R=301,L]

# Internally map /page -> /page.php
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [L]